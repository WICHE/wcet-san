{
    "name": "e3/paragon",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require-dev": {
        "behat/mink": "~1.7",
        "mikey179/vfsstream": "~1.2",
        "drupal/upgrade_rector": "^2.0@alpha",
        "drupal/upgrade_status": "^4.3"
    },
    "require": {
        "composer/installers": "^1.0",
        "cweagans/composer-patches": "~1.0",
        "wikimedia/composer-merge-plugin": "dev-master",
        "drupal/core": "^11",
        "drush/drush": "^13",
        "drupal/coffee": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/config_update": "^2.0",
        "drupal/contact_storage": "^1.0",
        "drupal/pathauto": "^1.0",
        "drupal/metatag": "^2.1",
        "drupal/redirect": "^1.0",
        "drupal/field_group": "^3.0",
        "drupal/paragraphs": "^1.12",
        "drupal/paragraphs_previewer": "^1.2",
        "drupal/inline_entity_form": "^3.0",
        "drupal/menu_block": "^1.0",
        "drupal/smart_trim": "^2.0",
        "drupal/link_attributes": "^2.0",
        "drupal/video_embed_field": "^3.1",
        "drupal/entity_browser": "^2.0",
        "drupal/focal_point": "^2.0",
        "drupal/embed": "^1.0",
        "drupal/entity_embed": "^1.0",
        "drupal/address": "^2.0",
        "drupal/name": "^1.0",
        "drupal/search_api": "^1.0",
        "drupal/search_api_solr": "^4.3.2",
        "drupal/chosen": "^3.0",
        "drupal/environment_indicator": "^4.0",
        "drupal/field_tools": "dev-1.x",
        "drupal/google_analytics": "^4.0",
        "drupal/ultimate_cron": "^2.0",
        "drupal/login_security": "^2.0",
        "drupal/markup": "^2.0",
        "drupal/paragraphs_browser": "^1.0-alpha2",
        "drupal/twig_field_value": "^2.0",
        "drupal/field_hidden": "^2.0",
        "drupal/mailsystem": "^4.0",
        "drupal/image_style_quality": "^1.0",
        "drupal/sitemap": "^2.0",
        "drupal/contact_storage_export": "^1.0",
        "drupal/seckit": "^2.0",
        "drupal/security_review": "^3.1",
        "drupal/entity_reference_revisions": "^1.3",
        "drupal/allowed_formats": "^3.0",
        "drupal/backup_migrate": "^5.0",
        "drupal/scheduler": "^1.0",
        "drupal/entity_clone": "^2.0@beta",
        "symfony/css-selector": "^7.0",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.0",
        "drupal/block_field": "^1.0",
        "drupal/migrate_source_csv": "^3.0",
        "drupal/simple_sitemap": "^4.0",
        "drupal/token": "^1.7",
        "drupal/graphql": "^3.0",
        "drupal/graphql_search_api": "^1.1",
        "drupal/search_api_exclude_entity": "^3.0",
        "drupal/media_entity_generic": "^1.1",
        "drupal/csv_serialization": "^4.0",
        "twig/twig": "^3.4.0",
        "drupal/webform": "^6.3",
        "drupal/views_data_export": "^1.1",
        "drupal/webform_views": "^5.0@beta",
        "drupal/entity_print": "^2.5",
        "drupal/config_ignore": "^3.0",
        "drupal/config_filter": "^2.4",
        "palantirnet/drupal-rector": "^0.15.1",
        "mglaman/composer-drupal-lenient": "^1.0",
        "drupal/classy": "^1.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/gin": "^5.0",
        "drupal/linkit": "^7.0",
        "drupal/symfony_mailer": "^1.4",
        "drupal/captcha": "^2.0",
        "drupal/core-recommended": "^11",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-dev": "^11",
        "drupal/action": "^0.2.2",
        "drupal/tour": "^3.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php",
            "scripts/composer/ParagonScriptHandler.php"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "excludes": [
                ".htaccess",
                "robots_hidden.txt",
                "docroot/modules/contrib/field_tools/.git",
                "docroot/modules/contrib/security_review/.git"
            ]
        },
        "installer-paths": {
            "docroot/core": [
                "drupal/core"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "merge-plugin": {
            "include": [
                "docroot/modules/custom/*/composer.json"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/graphql_search_api": {
                "d10_compatibility": "./patches/graphql_search_api_d10_compatibility.patch"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/field_hidden",
                "drupal/graphql_search_api",
                "drupal/classy"
            ]
        }
    },
    "scripts": {
        "drupal-scaffold": "DrupalComposer\\DrupalScaffold\\Plugin::scaffold",
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "DrupalProject\\composer\\ParagonScriptHandler::createPrivateTempDirectories",
            "DrupalProject\\composer\\ParagonScriptHandler::makeRobotsHidden"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "DrupalProject\\composer\\ParagonScriptHandler::createPrivateTempDirectories",
            "DrupalProject\\composer\\ParagonScriptHandler::makeRobotsHidden"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/console-extend-plugin": true,
            "drupal-composer/drupal-scaffold": true,
            "wikimedia/composer-merge-plugin": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "mglaman/composer-drupal-lenient": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "symfony/runtime": true
        }
    }
}
