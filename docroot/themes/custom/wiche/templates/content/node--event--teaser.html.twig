{#
/**
 * @file Event teaser → event card (Events listings, Figma 157:2644).
 * Fields: field_event_date, field_topic, field_image (optional).
 *
 * A self-contained card: image on top, then title, date and a "Learn more"
 * button pinned to the bottom (so cards in a row match height). Most events
 * have no image yet, so the card always shows an image area — a themed
 * placeholder graphic until the real one is uploaded — so cards read as
 * complete and consistent while content is still being added.
 */
#}
{% set has_image = node.field_image is not empty %}
<article{{ attributes.addClass('card', 'card--event') }}>
  <div class="card__media">
    {% if has_image %}
      <img src="{{ file_url(node.field_image.entity.uri.value) }}" alt="{{ node.field_image.alt }}" loading="lazy">
    {% else %}
      {# base_path resolves empty when this teaser renders inside a Views row
         (no leading slash → a broken relative URL), so hardcode the theme's
         absolute path rather than rely on base_path ~ directory here. #}
      <img src="/themes/custom/wiche/images/event-placeholder.svg" alt="" loading="lazy">
    {% endif %}
  </div>
  <h3 class="card__title"><a href="{{ url }}">{{ label }}</a></h3>
  {% if node.field_event_date.value %}
    <div class="card__meta"><strong>{{ 'Dates:'|t }}</strong> {{ node.field_event_date.value|date('F j, Y') }}</div>
  {% endif %}
  <div class="card__cta"><a href="{{ url }}">{{ 'Learn more'|t }}</a></div>
</article>
