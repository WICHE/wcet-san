{#
/**
 * @file Event teaser → event card (Events section).
 * event node: field_event_date, field_topic. (No image field on events yet —
 * add one to the event type to get the image-topped event cards from the design.)
 */
#}
{% set img = node.field_image.entity %}
{% set has_image = img is not null %}
<article{{ attributes.addClass('card', 'card--media', 'card--event') }}>
  {% if has_image %}
    <div class="card__media"><img src="{{ file_url(img.uri.value) }}" alt="{{ node.field_image.alt }}" loading="lazy"></div>
  {% endif %}
  <h3 class="card__title"><a href="{{ url }}">{{ label }}</a></h3>
  {% if node.field_event_date.value %}
    <div class="card__meta"><strong>{{ 'Date:'|t }}</strong> {{ node.field_event_date.value|date('F j, Y') }}</div>
  {% endif %}
  <div class="card__cta"><a href="{{ url }}">{{ 'Learn more'|t }}</a></div>
</article>
