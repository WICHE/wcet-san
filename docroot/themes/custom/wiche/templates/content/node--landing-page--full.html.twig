{#
/**
 * @file Landing page (full view) — hero first, then the breadcrumb trail,
 * then the rest of the page content (Figma 35:1632: breadcrumbs sit directly
 * below the hero, not above the whole page). `post_hero_breadcrumb` is the
 * same breadcrumb block, rendered here by
 * wiche_preprocess_node__landing_page() — its normal top-of-page placement is
 * hidden on landing pages via CSS so it never appears twice.
 */
#}
<article{{ attributes }}>

  {{ title_prefix }}
  {{ title_suffix }}

  {{ content.field_p_header }}

  {% if post_hero_breadcrumb %}
    <div class="region-breadcrumb region-breadcrumb--post-hero">
      <div class="wrap">{{ post_hero_breadcrumb }}</div>
    </div>
  {% endif %}

  <div{{ content_attributes }}>
    {{ content|without('field_p_header') }}
  </div>

</article>
