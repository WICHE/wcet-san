{#
/**
 * @file Resource full page → article page (Figma 53:499).
 *
 * Content model reality (learned from the data): a `resource` is mostly a
 * titled collection of downloadable links/files. 275/290 resources carry their
 * payload in `field_p_resources` (single_link + single_file paragraphs); only a
 * couple use `field_p_content` for prose. So we render:
 *   meta line (category · date · topic) → blue H1 → optional prose body →
 *   a "Downloads & links" panel (the links/files).
 * The page-title block is hidden on these pages (wiche.theme + components.css).
 */
#}
<article{{ attributes.addClass('resource-article') }}>
  <header class="resource-article__head">
    <div class="article-meta">
      {% if content.field_resource_type|render|trim is not empty %}
        <span class="article-meta__cat">{{ content.field_resource_type }}</span>
      {% endif %}
      <span class="article-meta__date">{{ node.getCreatedTime|date('n/j/Y') }}</span>
      {% if content.field_topic|render|trim is not empty %}
        <span class="article-meta__topic">{{ content.field_topic }}</span>
      {% endif %}
    </div>
    <h1 class="article-title">{{ label }}</h1>
  </header>

  {% if content.field_p_content|render|trim is not empty %}
    <div class="article-body flow-l">{{ content.field_p_content }}</div>
  {% endif %}

  {% if content.field_p_resources|render|trim is not empty %}
    <section class="resource-downloads">
      <h2 class="resource-downloads__title">{{ 'Downloads & links'|t }}</h2>
      <div class="resource-downloads__list">{{ content.field_p_resources }}</div>
    </section>
  {% endif %}
</article>
