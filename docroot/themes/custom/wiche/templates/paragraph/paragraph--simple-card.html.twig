{#
/**
 * @file Card — simple_card.
 * Fields: field_header (title), field_subheader (body), field_media_image,
 * field_link (CTA).
 *   • with image  → portrait image-overlay TILE (photo + gradient + white title
 *     + "Learn more" button), matching Figma 170:2329 / 26:32. Same look as the
 *     topic tiles, so "Topic Areas" rows are consistent.
 *   • no image → content/quick-link card: title, rule, optional body, outline
 *     "Learn more" button. One style whether or not there's body copy, so a
 *     Quick Links row looks the same on every page (it used to switch to a
 *     ghost "Read more" link when the body was empty).
 */
#}
{% set has_image = paragraph.field_media_image is not empty %}
{% set has_body = content.field_subheader|render|trim is not empty %}

{% if has_image %}
  <article{{ attributes.addClass('card', 'card--overlay') }}>
    {{ content.field_media_image }}
    <div class="card__inner">
      {% if paragraph.field_header.value %}
        <h3 class="card__title">{{ paragraph.field_header.value }}</h3>
      {% endif %}
      {% if has_body %}<div class="card__body">{{ content.field_subheader }}</div>{% endif %}
      {% if paragraph.field_link.0.url %}
        {# tiles use a consistent "Learn more" label (the link often has no title) #}
        <div class="card__cta"><a href="{{ paragraph.field_link.0.url }}">{{ paragraph.field_link.0.title ?: 'Learn more'|t }}</a></div>
      {% endif %}
    </div>
  </article>
{% else %}
  <article{{ attributes.addClass('card', 'card--cta') }}>
    {% if paragraph.field_header.value %}
      <h3 class="card__title">{{ paragraph.field_header.value }}</h3>
      <hr class="card__rule">
    {% endif %}
    {% if has_body %}<div class="card__body">{{ content.field_subheader }}</div>{% endif %}
    {% if paragraph.field_link.0.url %}
      {# same "Learn more" fallback as the image-overlay branch above — the
         generic link formatter would otherwise print the raw URL when the
         link has no title text, which is the common case for these cards. #}
      <div class="card__cta"><a href="{{ paragraph.field_link.0.url }}">{{ paragraph.field_link.0.title ?: 'Learn more'|t }}</a></div>
    {% endif %}
  </article>
{% endif %}
