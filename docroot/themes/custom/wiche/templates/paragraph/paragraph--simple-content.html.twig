{#
/**
 * @file Generic content block — simple_content.
 * Fields: field_header, field_subheader, field_body, field_links (up to 3),
 * field_link_alignment (left | center | right).
 * If there's a link and no body, render as a full-width CTA banner
 * (e.g. "Join SAN and Become a Member"); otherwise a readable content block.
 *
 * Links are looped from the raw field (not content.field_links) so a link
 * left without its own title text falls back to "Learn more" instead of the
 * generic link formatter's raw-URL fallback — same pattern as the topic/
 * event card "Learn more" buttons elsewhere in this theme.
 */
#}
{% set has_body = content.field_body|render|trim is not empty %}
{% set has_link = paragraph.field_links is not empty %}
{% set align = paragraph.field_link_alignment.value|default('left') %}
{% set align_modifier = {left: 'start', center: 'center', right: 'end'}[align] %}
{% if has_link and not has_body %}
  <section{{ attributes.addClass('section', 'paragraph-cta') }}>
    <div class="wrap">
      <div class="cta-banner">
        <h2>{{ paragraph.field_header.value }}</h2>
        <div class="cta-banner__action cta-banner__action--{{ align_modifier }}">
          {% for item in paragraph.field_links %}{{ link(item.title ?: 'Learn more'|t, item.url) }}{% endfor %}
        </div>
      </div>
    </div>
  </section>
{% else %}
  <section{{ attributes.addClass('section', 'paragraph-content') }}>
    <div class="wrap wrap--narrow flow-l">
      {% if paragraph.field_header.value %}<h2>{{ paragraph.field_header.value }}</h2>{% endif %}
      {% if paragraph.field_subheader.value %}<p class="lead">{{ paragraph.field_subheader.value }}</p>{% endif %}
      {{ content.field_body }}
      {% if has_link %}
        <div class="section-cta section-cta--{{ align_modifier }}">
          {% for item in paragraph.field_links %}{{ link(item.title ?: 'Learn more'|t, item.url) }}{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
