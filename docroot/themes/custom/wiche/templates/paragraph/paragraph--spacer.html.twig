{#
/**
 * @file Spacer — adds author-controlled vertical space between components.
 * Fields: field_spacer_size (small | medium | large); field_divider_line
 * (bool) — a thin grey rule centered in the gap, for separating content
 * sections on long content pages. Heights/rule live in components.css
 * (.spacer--*, .spacer__rule).
 */
#}
{% set size = paragraph.field_spacer_size.value|default('medium') %}
{% set has_rule = paragraph.field_divider_line.value %}
<div{{ attributes.addClass('spacer', 'spacer--' ~ size, has_rule ? 'spacer--rule') }} aria-hidden="true">
  {% if has_rule %}<hr class="spacer__rule">{% endif %}
</div>
