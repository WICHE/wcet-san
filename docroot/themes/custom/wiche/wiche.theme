<?php

/**
 * @file
 * Theme hooks and preprocess for the wiche (WCET SAN) theme.
 *
 * Intentionally minimal — add body classes, template suggestions, and
 * paragraph/component preprocessing here as the build grows.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 *
 * Adds a hook for future body-level classes (theme variants, etc.).
 */
function wiche_preprocess_html(array &$variables): void {
  // Placeholder for art-direction: e.g. a data-theme attribute or body class.
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 *
 * Lets each paragraph type have a template like
 * paragraph--{type}.html.twig and, optionally, per-view-mode variants.
 */
function wiche_theme_suggestions_paragraph_alter(array &$suggestions, array $variables): void {
  $paragraph = $variables['elements']['#paragraph'] ?? NULL;
  if ($paragraph !== NULL) {
    $view_mode = $variables['elements']['#view_mode'] ?? 'default';
    $suggestions[] = 'paragraph__' . $paragraph->bundle() . '__' . $view_mode;
  }
}
