<?php

/**
 * @file
 * Theme hooks and preprocess for the wiche (WCET SAN) theme.
 *
 * Intentionally minimal — add body classes, template suggestions, and
 * paragraph/component preprocessing here as the build grows.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 *
 * Adds a hook for future body-level classes (theme variants, etc.).
 */
function wiche_preprocess_html(array &$variables): void {
  // Tag the <body> with the node bundle on canonical node pages so component
  // CSS can adapt (e.g. the resource/event full templates render their own H1,
  // so the page-title block is hidden on those pages — see components.css).
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface) {
    $variables['attributes']['class'][] = 'page-node';
    $variables['attributes']['class'][] = 'page-node-type-' . $node->bundle();
  }

  // A stable, route-based body class so listing pages (e.g. the resources view)
  // can be styled without depending on the view's dynamic dom-id class.
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route !== NULL) {
    // Normalise separators (dots + underscores) to hyphens so the class is
    // predictable, e.g. view.resources.page_resources → view-resources-page-resources.
    $slug = \Drupal\Component\Utility\Html::cleanCssIdentifier(str_replace(['.', '_'], '-', $route));
    $variables['attributes']['class'][] = 'route--' . $slug;
  }
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 *
 * Lets each paragraph type have a template like
 * paragraph--{type}.html.twig and, optionally, per-view-mode variants.
 */
function wiche_theme_suggestions_paragraph_alter(array &$suggestions, array $variables): void {
  $paragraph = $variables['elements']['#paragraph'] ?? NULL;
  if ($paragraph !== NULL) {
    $view_mode = $variables['elements']['#view_mode'] ?? 'default';
    $suggestions[] = 'paragraph__' . $paragraph->bundle() . '__' . $view_mode;
  }
}
